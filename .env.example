# Copia este archivo como .env.local y completa los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). Son necesarios para el editor; el portafolio
# funciona sin ellos con el contenido de data/cv.ts.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anonima
